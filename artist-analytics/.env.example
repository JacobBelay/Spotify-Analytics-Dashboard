# Copy to .env and fill in what you have. Everything is optional except the DB,
# which docker-compose sets for you.

POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics
POSTGRES_DB=analytics

# --- Claude (trend reports, scenario explanations, Q&A) ---
# Without a key the app still works and falls back to a rule-based summary.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- YouTube ---
# Data API key: public channel stats (subscribers, views) for any artist.
YOUTUBE_API_KEY=
# OAuth client (Google Cloud Console > Credentials > OAuth client ID, type "Web").
# Lets artists click "Connect YouTube" to share daily channel analytics.
# Authorized redirect URI: http://localhost:8000/api/auth/youtube/callback
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# --- Spotify (metadata + release dates only in dev mode since Feb 2026) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Apple Music catalog API (release dates) ---
# Developer token = ES256 JWT signed with a MusicKit key from developer.apple.com
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_PATH=
APPLE_MUSIC_STOREFRONT=us

PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Days before the app nudges an artist to upload a fresh Spotify/Apple export
STALE_AFTER_DAYS=7

# Hours between worker runs
INGEST_INTERVAL_HOURS=24
